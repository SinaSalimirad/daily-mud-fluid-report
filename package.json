{
	"name": "daily-mud-fluid-report",
	"version": "0.1.1",
	"private": true,
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "bun run --filter '*' typecheck",
		"api:dev": "bun --filter @daily-mud-fluid-report/api dev",
		"api:build": "bun --filter @daily-mud-fluid-report/api build",
		"web:dev": "bun --filter @daily-mud-fluid-report/web dev",
		"web:build": "bun --filter @daily-mud-fluid-report/web build",
		"db:generate": "bun run --filter @daily-mud-fluid-report/api db:generate",
		"db:migrate": "bun run --filter @daily-mud-fluid-report/api db:migrate",
		"db:push": "bun run --filter @daily-mud-fluid-report/api db:push",
		"db:studio": "bun run --filter @daily-mud-fluid-report/api db:studio",
		"docker:dev:up": "docker compose --env-file .env -f infra/docker/compose.dev.yml up -d --build",
		"docker:dev:down": "docker compose --env-file .env -f infra/docker/compose.dev.yml down",
		"docker:dev:db": "docker compose --env-file .env -f infra/docker/compose.dev.yml up -d --build postgres"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	},
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
