{
	"name": "daily-mud-fluid-report",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "bun run --filter '*' typecheck"
    },
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	},
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
