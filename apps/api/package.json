{
	"name": "@daily-mud-fluid-report/api",
	"private": true,
	"packageManager": "bun@1.4.4",
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"dev": "bun run --env-file=../../.env --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun --minify",
		"start": "bun run dist/index.js",
		"db:generate": "bun run --env-file=../../.env drizzle-kit generate",
		"db:migrate": "bun run --env-file=../../.env drizzle-kit migrate",
		"db:push": "bun run --env-file=../../.env drizzle-kit push",
		"db:studio": "bun run --env-file=../../.env drizzle-kit studio"
	},
	"dependencies": {
		"@elysia/openapi": "^1.4.16",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"elysia": "^1.4.30",
		"pg": "^8.23.1",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.11"
	}
}
