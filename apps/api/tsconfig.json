{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"types": ["bun-types"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
